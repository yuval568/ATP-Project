<?xml version="1.0" encoding="UTF-8"?>
<?import View.MazeDisplayer?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="View.MyViewController"
      prefWidth="850" prefHeight="650"
      onKeyPressed="#keyPressed">

    <MenuBar>
        <Menu text="File">
            <MenuItem text="New" onAction="#generateMaze"/>
            <MenuItem fx:id="menuSave" text="Save" onAction="#saveMaze" disable="true"/>
            <MenuItem text="Load" onAction="#loadMaze"/>
            <MenuItem text="Properties" onAction="#showProperties"/>
            <MenuItem text="Exit" onAction="#exitApplication"/>
        </Menu>
        <Menu text="Options">
            <CheckMenuItem text="Fog of War" onAction="#toggleFogOfWar"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="Help" onAction="#showHelp"/>
            <MenuItem text="About" onAction="#showAbout"/>
        </Menu>
    </MenuBar>

    <!-- Welcome Screen -->
    <StackPane fx:id="welcomeScreen" VBox.vgrow="ALWAYS">
        <ImageView preserveRatio="false" fitWidth="850" fitHeight="620">
            <image>
                <Image url="/Images/messi.png"/>
            </image>
        </ImageView>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: rgba(0,0,0,0.45); -fx-padding: 40;">
            <Label text="🏆 Welcome to the World Cup Challenge! ⚽"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, black, 10, 0.8, 0, 0);"/>
            <Label text="Navigate Messi through the maze to win the World Cup!"
                   style="-fx-font-size: 16px; -fx-text-fill: #f0f0f0;"/>
            <Button text="Start Game" onAction="#startGame"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: #f5c518; -fx-text-fill: #1a1a1a; -fx-padding: 12 40; -fx-background-radius: 30; -fx-cursor: hand;"/>
        </VBox>
    </StackPane>

    <!-- Main Game Screen (hidden initially) -->
    <BorderPane fx:id="gameScreen" VBox.vgrow="ALWAYS" visible="false" managed="false">
        <left>
            <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: #1a1a2e;">
                <Label text="Maze Options" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                <HBox spacing="5">
                    <Label text="Rows:" style="-fx-text-fill: white;"/>
                    <TextField fx:id="txtRows" text="15" prefWidth="50"/>
                </HBox>
                <HBox spacing="5">
                    <Label text="Cols:" style="-fx-text-fill: white;"/>
                    <TextField fx:id="txtCols" text="15" prefWidth="50"/>
                </HBox>
                <Button text="Generate Maze" onAction="#generateMaze" prefWidth="120"
                        style="-fx-background-color: #f5c518; -fx-font-weight: bold;"/>
                <Button fx:id="btnSolve" text="Solve Maze" onAction="#solveMaze" prefWidth="120" disable="true"
                        style="-fx-background-color: #16213e; -fx-text-fill: white;"/>
                <Button fx:id="btnSave" text="Save Maze" onAction="#saveMaze" prefWidth="120" disable="true"
                        style="-fx-background-color: #16213e; -fx-text-fill: white;"/>
                <Button text="Load Maze" onAction="#loadMaze" prefWidth="120"
                        style="-fx-background-color: #16213e; -fx-text-fill: white;"/>
            </VBox>
        </left>
        <center>
            <VBox alignment="CENTER" style="-fx-padding: 10;" BorderPane.alignment="CENTER">
                <MazeDisplayer fx:id="mazeDisplayer"
                               width="620"
                               height="620"
                               imageFileNameCharacter="/Images/messiPlayer.jpg"
                               onMouseDragged="#mouseDragged"
                               onScroll="#scrollZoom"/>
            </VBox>
        </center>
    </BorderPane>

</VBox>
